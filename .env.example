# App listens on loopback only by default.
HOST=127.0.0.1
PORT=3001
VITE_PORT=5173
# Production mode only, rolling 24h. Development local render jobs are unlimited but remain in history.
DAILY_JOB_LIMIT=1
MAX_UPLOAD_MB=100
# Gemini Developer API Free Tier only. Leave key blank / guard false to disable AI Voice.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FREE_TIER_ONLY=false
GEMINI_TTS_DAILY_REQUEST_LIMIT=10
# AI Generation Mode is persisted in SQLite and defaults to Development. Gemini Text shares the backend-only key above, but uses its own model, Free Tier guard, and request quota.
# Text Free Tier allowlist: gemini-3.8-flash, gemini-3.5-flash-lite. gemini-3.5-flash-lite is default.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_FREE_TIER_ONLY=false
AI_GENERATION_DAILY_REQUEST_LIMIT=10
# Optional per-model project limits from Google AI Studio. Blank = no local project-limit cap.
# Usage counters are local records; Google does not expose official remaining quota through this app.
GEMINI_TEXT_RPM_LIMIT=
GEMINI_TEXT_RPD_LIMIT=
GEMINI_TEXT_TPM_LIMIT=
# Development one-click provider. OpenCode must run on loopback with Basic auth; use same username/password here.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Optional Hugging Face Inference Providers image generation. Disabled unless both flags and server token are set.
# Inference may be billed; this app cannot verify account balance, remaining credit, or per-image price.
HF_TOKEN=
HF_IMAGE_GENERATION_ENABLED=false
HF_IMAGE_ALLOW_PAID=false
# Candidate only; server verifies selected model against live hf-inference text-to-image mappings.
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
