{
  "name": "ai-facts-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "smoke:api": "tsx scripts/api-smoke.ts",
    "smoke:tts": "tsx scripts/tts-smoke.ts",
    "render": "tsx scripts/render.ts",
    "smoke:render": "tsx scripts/render-smoke.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.466",
    "@remotion/player": "4.0.466",
    "@remotion/renderer": "4.0.466",
    "@google/genai": "2.31.0",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.466",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "9.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "zod": "4.6.7",
    "ws": "8.22.0",
    "postcss": "8.5.31",
    "@remotion/bundler": {
      "esbuild": "0.28.2"
    }
  }
}
